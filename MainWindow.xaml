<Window x:Class="FloatingKeys.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Floating Keys" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="CanResize"
        SizeToContent="Height" Width="360" MinWidth="190" MaxWidth="900"
        WindowStartupLocation="Manual" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="KeyBtn" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI"/>
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Width" Value="52"/>
            <Setter Property="Height" Value="56"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="8" BorderThickness="1"
                                Background="{DynamicResource KeyBg}" BorderBrush="{DynamicResource Stroke}">
                            <Border.Effect><DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.25"/></Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource KeyHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource KeyPress}"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="Flash">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Accent}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentFg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ToolBtn" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="{DynamicResource FgMuted}"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="5" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource KeyHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="8" CornerRadius="12" BorderThickness="1"
            Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Stroke}">
        <Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.35"/></Border.Effect>
        <StackPanel>
            <Grid x:Name="TitleBar" Margin="10,6,6,0" Background="Transparent"
                  MouseLeftButtonDown="TitleBar_MouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#FF3FB950" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Floating Keys" FontSize="11" Foreground="{DynamicResource FgMuted}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="ModText" Margin="8,0,0,0" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"/>
                </StackPanel>
                <Button Grid.Column="2" Content="&#x2699;" Style="{StaticResource ToolBtn}" ToolTip="Settings" Click="Settings_Click"/>
                <Button Grid.Column="3" Content="&#x2013;" Style="{StaticResource ToolBtn}" ToolTip="Hide to tray (Ctrl+Alt+K to show)" Click="Hide_Click"/>
                <Button Grid.Column="4" Content="&#x2715;" Style="{StaticResource ToolBtn}" ToolTip="Exit" Click="Close_Click"/>
            </Grid>

            <Viewbox Stretch="Uniform" Margin="8,2,8,8">
                <UniformGrid x:Name="KeyGrid" Columns="6"/>
            </Viewbox>

            <StackPanel x:Name="SettingsPanel" Visibility="Collapsed" Margin="14,0,14,10">
                <DockPanel Margin="0,0,0,6">
                    <TextBlock Text="Opacity" Foreground="{DynamicResource Fg}" FontSize="12" Width="55" VerticalAlignment="Center"/>
                    <Slider x:Name="OpacitySlider" Minimum="0.3" Maximum="1" Value="0.95" Focusable="False"
                            ValueChanged="Opacity_Changed"/>
                </DockPanel>
                <CheckBox x:Name="TwoRowsCheck" Content="Two-row layout" Focusable="False" Foreground="{DynamicResource Fg}"
                          FontSize="12" Margin="0,2" Click="TwoRows_Click"/>
                <CheckBox x:Name="StartupCheck" Content="Start with Windows" Focusable="False" Foreground="{DynamicResource Fg}"
                          FontSize="12" Margin="0,2" Click="Startup_Click"/>
                <Button x:Name="ThemeBtn" Style="{StaticResource ToolBtn}" Width="Auto" Height="26" HorizontalAlignment="Left"
                        Padding="8,0" Margin="0,4,0,0" Click="Theme_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
